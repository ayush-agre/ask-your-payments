# ==============================================================================
# Ask-Your-Payments: Environment Configuration Template
# Team CrackerX · FinOps Hackathon 2026
# ==============================================================================
# Copy this file to '.env' and fill in the placeholder values before running.
# Never commit the actual '.env' file containing real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE & PERSISTENCE LAYER (Supabase / PostgreSQL)
# ------------------------------------------------------------------------------
# PostgreSQL / Supabase connection URI.
# The backend dynamically configures the 'postgresql+asyncpg://' driver.
# Example: postgresql://postgres:YourSecurePassword@db.yourprojectref.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD_HERE@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# 2. AI & INTELLIGENCE LAYER (Google Gemini)
# ------------------------------------------------------------------------------
# Google Gemini API Key for natural language financial queries, PII scrubbing,
# root-cause investigation, and Generative UI dynamic responses.
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 3. PAYPAL & APIMATIC SDK GATEWAY CREDENTIALS (Sandbox)
# ------------------------------------------------------------------------------
# PayPal REST API OAuth 2.0 Client ID (from developer.paypal.com)
PAYPAL_CLIENT_ID=your_paypal_client_id_here

# PayPal REST API OAuth 2.0 Client Secret
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here

# Fallback alias for PAYPAL_CLIENT_SECRET (optional, used by legacy scripts)
PAYPAL_SECRET=your_paypal_client_secret_here

# PayPal Webhook ID used for cryptographic asymmetric signature verification
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id_here

# PayPal API Base URL (defaults to Sandbox)
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# ------------------------------------------------------------------------------
# 4. ERP & WEBHOOK TUNNELING (Optional / Local Dev)
# ------------------------------------------------------------------------------
# ERP General Ledger API Base URL (defaults to internal backend port)
ERP_BASE_URL=http://localhost:8000

# ngrok auth token for forwarding live PayPal webhooks to localhost during testing
NGROK_AUTHTOKEN=your_ngrok_authtoken_optional

# ------------------------------------------------------------------------------
# 5. FRONTEND & AG GRID ENTERPRISE (Next.js Client-Side)
# ------------------------------------------------------------------------------
# Backend API Base URL consumed by Next.js client
NEXT_PUBLIC_API_URL=http://localhost:8000

# Real-time WebSocket connection URL for AG Grid SSRM async updates
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/events

# AG Grid Enterprise License Key (leave blank or provide test key)
NEXT_PUBLIC_AG_GRID_LICENSE_KEY=your_ag_grid_enterprise_license_key_here
